           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="saveLogsButton">
            <property name="text">
             <string>Сохранить логи</string>
            </property>
           </widget>
          </item>
          <item>
           <!-- ЗДЕСЬ ИСПРАВЛЕНИЕ: spacer заменен на QSpacerItem -->
           <widget class="QSpacerItem" name="horizontalSpacer">
            <property name="orientation">
